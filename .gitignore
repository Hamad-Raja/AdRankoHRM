
# ==========================================
# OfficeHR - Root Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Build outputs
dist/
dist-ssr/
build/
coverage/
.next/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests
tests/
test/
__tests__/
__snapshots__/
*.test.js
*.test.jsx
*.test.ts
*.test.tsx
*.spec.js
*.spec.jsx
*.spec.ts
*.spec.tsx
playwright-report/
test-results/
.nyc_output/

# Artifacts and generated reports
artifacts/
reports/
report/
screenshots/
test-output/
test-artifacts/
*.log.*
*.lcov

# Project reports and documentation
**/README.md
**/REPORT*.md
**/*REPORT*.md
**/*COMPLETION*.md
**/*SUMMARY*.md
**/*AUDIT*.md
**/*CHECKLIST*.md
**/AUTH_CONNECTION*.md
**/PHASE*.md

# Local AI assistant configuration
.agents/
.claude/
.windsurf/
.cursor/
.codex/
skills-lock.json

# Generated Prisma client
**/generated/prisma/
**/src/generated/prisma/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Temporary files
tmp/
temp/
.cache/
*.tmp
*.bak
*.backup
*.local

# Local databases
*.sqlite
*.sqlite3
*.db
