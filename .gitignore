
# ==========================================
# OfficeHR - Root Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# Build outputs
dist/
dist-ssr/
build/
coverage/
.next/
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test source and guarded fixtures belong in version control.
# Only generated results/caches are ignored.
playwright-report/
test-results/
.nyc_output/

# Artifacts and generated reports
artifacts/
reports/
report/
screenshots/
test-output/
test-artifacts/
*.log.*
*.lcov

# Project reports and documentation
**/README.md
**/REPORT*.md
**/*REPORT*.md
**/*COMPLETION*.md
**/*SUMMARY*.md
**/*AUDIT*.md
**/*CHECKLIST*.md
**/AUTH_CONNECTION*.md
**/PHASE*.md

# Local AI assistant configuration
.agents/
.claude/
.windsurf/
.cursor/
.codex/
skills-lock.json

# Generated Prisma client
**/generated/prisma/
**/src/generated/prisma/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Temporary files
tmp/
temp/
.cache/
*.tmp
*.bak
*.backup
*.local

# Test-only generated output; never version private inventories or credentials.
**/tests/.cache/
**/tests/output/
private/
!FINAL_TECHNICAL_AUDIT_REPORT.md
!MANUAL_ACCEPTANCE_TEST_CHECKLIST.md

# Local databases
*.sqlite
*.sqlite3
*.db

# ==========================================
# Test folders - Never push to GitHub
# ==========================================

backend/tests/
frontend/tests/

# Other common test directories
**/__tests__/
**/e2e/
**/test/
**/tests/