generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  NOTICE_PERIOD
  SUSPENDED
  EXITED
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique @db.VarChar(254)
  displayName         String        @db.VarChar(120)
  passwordHash        String        @db.Text
  role                Role          @default(EMPLOYEE)
  status              AccountStatus @default(ACTIVE)
  mustChangePassword  Boolean       @default(true)
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?     @db.Timestamptz(3)
  lastLoginAt         DateTime?     @db.Timestamptz(3)
  passwordChangedAt   DateTime      @default(now()) @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  sessions                       UserSession[]
  auditLogs                      AuditLog[]                    @relation("AuditActor")
  employee                       Employee?                     @relation("EmployeeAccount")
  employmentStatusEvents         EmploymentStatusEvent[]       @relation("EmploymentStatusActor")
  approvedEmploymentStatusEvents EmploymentStatusEvent[]       @relation("EmploymentStatusApprover")
  organizationChanges            OrganizationUnit[]
  assignmentChanges              OrganizationAssignment[]
  managerChanges                 TeamManagerAssignment[]       @relation("ManagerActor")
  managedTeams                   TeamManagerAssignment[]       @relation("TeamManager")
  uploadedDocuments              EmployeeDocument[]
  shiftDefinitions               ShiftDefinition[]
  officeSchedules                OfficeSchedule[]
  officeScheduleDrafts           OfficeScheduleDraft[]
  companyHolidayEvents           CompanyHolidayEvent[]
  shiftAssignments               EmployeeShiftAssignment[]     @relation("ShiftAssignmentActor")
  shiftAssignmentClosures        EmployeeShiftAssignment[]     @relation("ShiftAssignmentCloser")
  attendanceClockIns             AttendanceRecord[]            @relation("AttendanceClockInActor")
  attendanceClockOuts            AttendanceRecord[]            @relation("AttendanceClockOutActor")
  correctionRequests             AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  correctionReviews              AttendanceCorrectionRequest[] @relation("CorrectionReviewer")

  salaryVersions        EmployeeSalaryVersion[] @relation("SalaryVersionActor")
  payrollsCreated       PayrollRecord[]         @relation("PayrollCreator")
  payrollsUpdated       PayrollRecord[]         @relation("PayrollUpdater")
  payrollsHrApproved    PayrollRecord[]         @relation("PayrollHrApprover")
  payrollsAdminApproved PayrollRecord[]         @relation("PayrollAdminApprover")
  payrollsPaid          PayrollRecord[]         @relation("PayrollPaidActor")
  payrollPayments       PayrollPayment[]        @relation("PayrollPaymentActor")

  announcements      Announcement[]     @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[] @relation("UserAnnouncementReads")
  notifications      Notification[]     @relation("UserNotifications")
  actorNotifications Notification[]     @relation("NotificationActor")

  @@index([status, role])
  @@map("users")
}

model UserSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress     String?   @db.Inet
  userAgent     String?   @db.VarChar(512)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  success     Boolean
  targetType  String?  @db.VarChar(80)
  targetId    String?  @db.VarChar(100)
  metadata    Json?
  ipAddress   String?  @db.Inet
  userAgent   String?  @db.VarChar(512)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}

model Employee {
  id                           String   @id @default(uuid()) @db.Uuid
  employeeCode                 String   @unique @db.VarChar(30)
  userId                       String?  @unique @db.Uuid
  fullName                     String   @db.VarChar(120)
  personalEmail                String?  @db.VarChar(254)
  phone                        String?  @db.VarChar(32)
  address                      String?  @db.VarChar(1000)
  emergencyContactName         String?  @db.VarChar(120)
  emergencyContactPhone        String?  @db.VarChar(32)
  emergencyContactRelationship String?  @db.VarChar(60)
  version                      Int      @default(1)
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime @updatedAt @db.Timestamptz(3)

  user               User?                         @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: Restrict)
  employmentEpisodes EmploymentEpisode[]
  assignments        OrganizationAssignment[]
  documents          EmployeeDocument[]
  shiftAssignments   EmployeeShiftAssignment[]
  attendanceRecords  AttendanceRecord[]
  correctionRequests AttendanceCorrectionRequest[]

  salaryVersions EmployeeSalaryVersion[]
  payrollRecords PayrollRecord[]

  @@index([fullName, id])
  @@map("employees")
}

enum OrganizationKind {
  DEPARTMENT
  CAMPAIGN
  TEAM
  DESIGNATION
}

model OrganizationUnit {
  id                     String                   @id @default(uuid()) @db.Uuid
  kind                   OrganizationKind
  name                   String                   @db.VarChar(120)
  departmentId           String?                  @db.Uuid
  campaignId             String?                  @db.Uuid
  archivedAt             DateTime?                @db.Timestamptz(3)
  actorUserId            String                   @db.Uuid
  reason                 String                   @db.VarChar(1000)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)

  actor                  User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  department             OrganizationUnit?        @relation("TeamDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  campaign               OrganizationUnit?        @relation("TeamCampaign", fields: [campaignId], references: [id], onDelete: Restrict)
  departmentTeams        OrganizationUnit[]       @relation("TeamDepartment")
  campaignTeams          OrganizationUnit[]       @relation("TeamCampaign")
  assignments            OrganizationAssignment[]
  managers               TeamManagerAssignment[]
  designationAssignments OrganizationAssignment[] @relation("DesignationAssignments")
  announcements          Announcement[]           @relation("AnnouncementDepartment")

  @@unique([kind, name])
  @@map("organization_units")
}

model OrganizationAssignment {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  teamId        String   @db.Uuid
  designationId String   @db.Uuid
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  actorUserId   String   @db.Uuid
  reason        String   @db.VarChar(1000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  team        OrganizationUnit @relation(fields: [teamId], references: [id], onDelete: Restrict)
  designation OrganizationUnit @relation("DesignationAssignments", fields: [designationId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([teamId, effectiveFrom])
  @@map("organization_assignments")
}

model TeamManagerAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  teamId        String    @db.Uuid
  managerUserId String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  actorUserId   String    @db.Uuid
  reason        String    @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  team    OrganizationUnit @relation(fields: [teamId], references: [id], onDelete: Restrict)
  manager User             @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  actor   User             @relation("ManagerActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([managerUserId, effectiveFrom])
  @@map("team_manager_assignments")
}

model EmployeeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @db.Uuid
  replacesId   String?  @unique @db.Uuid
  title        String   @db.VarChar(120)
  storageName  String   @unique @db.VarChar(80)
  mediaType    String   @db.VarChar(80)
  byteLength   Int
  ownerVisible Boolean  @default(false)
  actorUserId  String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  actor       User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  replaces    EmployeeDocument? @relation("DocumentVersions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement EmployeeDocument? @relation("DocumentVersions")

  @@index([employeeId, createdAt])
  @@map("employee_documents")
}

model EmploymentEpisode {
  id                  String           @id @default(uuid()) @db.Uuid
  employeeId          String           @db.Uuid
  startDate           DateTime         @db.Date
  endDate             DateTime?        @db.Date
  status              EmploymentStatus
  statusEffectiveDate DateTime         @db.Date
  probationEndDate    DateTime?        @db.Date
  confirmedOn         DateTime?        @db.Date
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  statusEvents    EmploymentStatusEvent[]
  shiftAssignments EmployeeShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([employeeId, startDate])
  @@index([employeeId, status])
  @@index([status, startDate])
  @@map("employment_episodes")
}

model EmploymentStatusEvent {
  id                  String            @id @default(uuid()) @db.Uuid
  employmentEpisodeId String            @db.Uuid
  fromStatus          EmploymentStatus?
  toStatus            EmploymentStatus
  effectiveDate       DateTime          @db.Date
  reason              String            @db.VarChar(1000)
  actorUserId         String            @db.Uuid
  approvedByUserId    String?           @db.Uuid
  approvedAt          DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)

  employmentEpisode EmploymentEpisode @relation(fields: [employmentEpisodeId], references: [id], onDelete: Restrict)
  actor             User              @relation("EmploymentStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  approvedBy        User?             @relation("EmploymentStatusApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([employmentEpisodeId, effectiveDate, createdAt], map: "employment_status_timeline_idx")
  @@index([actorUserId, createdAt], map: "employment_status_actor_idx")
  @@index([approvedByUserId])
  @@map("employment_status_events")
}

// A definition is immutable. Create a new named version for schedule changes.
model ShiftDefinition {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @unique @db.VarChar(120)
  timeZone      String    @db.VarChar(80)
  startTime     String    @db.VarChar(5)
  endTime       String    @db.VarChar(5)
  endsNextDay   Boolean
  workDays      Int[]
  breakMinutes  Int
  breakPaid     Boolean?
  graceMinutes  Int
  archivedAt    DateTime? @db.Timestamptz(3)
  actorUserId   String    @db.Uuid
  reason        String    @db.VarChar(1000)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  actor       User                      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  assignments EmployeeShiftAssignment[]

  @@index([archivedAt, name])
  @@map("shift_definitions")
}

model EmployeeShiftAssignment {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeId          String    @db.Uuid
  employmentEpisodeId String    @db.Uuid
  shiftId             String    @db.Uuid
  effectiveFrom       DateTime  @db.Date
  effectiveTo         DateTime? @db.Date
  actorUserId         String    @db.Uuid
  reason              String    @db.VarChar(1000)
  closedByUserId      String?   @db.Uuid
  closedReason        String?   @db.VarChar(1000)
  closedAt            DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentEpisode EmploymentEpisode @relation(fields: [employmentEpisodeId], references: [id], onDelete: Restrict)
  shift             ShiftDefinition   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  actor             User              @relation("ShiftAssignmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  closedBy          User?             @relation("ShiftAssignmentCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@index([shiftId, effectiveFrom])
  @@index([employmentEpisodeId])
  @@map("employee_shift_assignments")
}

// Append-only office policy.
// Intervals end immediately before the next effectiveFrom.
model OfficeSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  effectiveFrom DateTime @unique @db.Date
  startTime    String   @default("19:00") @db.VarChar(5)
  endTime      String   @default("05:00") @db.VarChar(5)
  endsNextDay  Boolean  @default(true)
  policy       Json
  actorUserId  String   @db.Uuid
  reason       String   @db.VarChar(1000)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  draftId      String?  @unique @db.Uuid

  actor             User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  draft             OfficeScheduleDraft? @relation(fields: [draftId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@map("office_schedules")
}

model OfficeScheduleDraft {
  id          String   @id @default(uuid()) @db.Uuid
  revision    Int      @unique
  policy      Json
  actorUserId String   @db.Uuid
  reason      String   @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor      User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  activation OfficeSchedule?

  @@map("office_schedule_drafts")
}

model CompanyHolidayEvent {
  id          String   @id @default(uuid()) @db.Uuid
  holidayDate DateTime @db.Date
  revision    Int
  action      String   @db.VarChar(10)
  actorUserId String   @db.Uuid
  reason      String   @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([holidayDate, revision], map: "company_holiday_events_date_revision_key")
  @@map("company_holiday_events")
}

// --- Attendance ---

enum AttendanceStatus {
  OPEN
  COMPLETED
  MISSING_CHECKOUT
  CORRECTED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceRecord {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String           @db.Uuid
  employmentEpisodeId String           @db.Uuid
  shiftDate           DateTime         @db.Date
  scheduledStart      DateTime         @db.Timestamptz(3)
  scheduledEnd        DateTime         @db.Timestamptz(3)
  scheduleTimeZone    String           @db.VarChar(80)
  graceMinutes        Int
  clockInAt           DateTime         @db.Timestamptz(3)
  clockOutAt          DateTime?        @db.Timestamptz(3)
  status              AttendanceStatus @default(OPEN)
  isLate              Boolean          @default(false)
  isEarlyDeparture    Boolean          @default(false)
  isMissingCheckout   Boolean          @default(false)
  isAfterScheduleEnd  Boolean          @default(false)
  workedMinutes       Int?
  clockInRequestId    String           @unique @db.VarChar(64)
  clockOutRequestId   String?          @unique @db.VarChar(64)
  clockInActorUserId  String           @db.Uuid
  clockOutActorUserId String?          @db.Uuid
  scheduleSnapshot    Json
  officeScheduleId    String?          @db.Uuid
  approvedAdjustment  Json?
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentEpisode EmploymentEpisode @relation(fields: [employmentEpisodeId], references: [id], onDelete: Restrict)
  officeSchedule    OfficeSchedule?   @relation(fields: [officeScheduleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  clockInActor      User              @relation("AttendanceClockInActor", fields: [clockInActorUserId], references: [id], onDelete: Restrict)
  clockOutActor     User?             @relation("AttendanceClockOutActor", fields: [clockOutActorUserId], references: [id], onDelete: Restrict)
  corrections       AttendanceCorrectionRequest[]

  @@unique([employeeId, shiftDate])
  @@index([employeeId, shiftDate])
  @@index([status])
  @@index([shiftDate])
  @@map("attendance_records")
}

model AttendanceCorrectionRequest {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendanceRecordId String?          @db.Uuid
  employeeId         String           @db.Uuid
  shiftDate          DateTime         @db.Date
  requestType        String           @db.VarChar(50)
  correctedClockIn   DateTime?        @db.Timestamptz(3)
  correctedClockOut  DateTime?        @db.Timestamptz(3)
  reason             String           @db.VarChar(1000)
  status             CorrectionStatus @default(PENDING)
  requestedByUserId  String           @db.Uuid
  reviewedByUserId   String?          @db.Uuid
  reviewReason       String?          @db.VarChar(1000)
  reviewedAt         DateTime?        @db.Timestamptz(3)
  originalData       Json?
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy      User              @relation("CorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?             @relation("CorrectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId, shiftDate])
  @@index([status])
  @@map("attendance_correction_requests")
}

// --- Salary and Payroll ---

enum PayrollStatus {
  DRAFT
  HR_APPROVED
  APPROVED
  PAID
}

enum PayrollPaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

model EmployeeSalaryVersion {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  effectiveMonth DateTime @db.Date
  revision       Int
  previousId     String?  @unique(map: "salary_previous_key") @db.Uuid
  monthlyBasic   Decimal  @db.Decimal(14, 2)
  currency       String   @default("PKR") @db.Char(3)
  actorUserId    String   @db.Uuid
  reason         String   @db.VarChar(1000)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User                   @relation("SalaryVersionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previous       EmployeeSalaryVersion? @relation("SalaryVersionChain", fields: [previousId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacement    EmployeeSalaryVersion? @relation("SalaryVersionChain")
  payrollRecords PayrollRecord[]

  @@unique([employeeId, effectiveMonth, revision], map: "salary_employee_month_revision_key")
  @@index([actorUserId, createdAt], map: "salary_actor_created_idx")
  @@map("employee_salary_versions")
}

model PayrollRecord {
  id                    String        @id @default(uuid()) @db.Uuid
  employeeId            String        @db.Uuid
  salaryVersionId       String        @db.Uuid
  payrollMonth          DateTime      @db.Date
  currency              String        @default("PKR") @db.Char(3)
  basis                 String        @default("MANUAL_DAYS") @db.VarChar(20)
  calculationVersion    String        @default("MANUAL_DAYS_V1") @db.VarChar(40)
  rounding              String        @default("HALF_UP_TO_PAISA") @db.VarChar(32)

  monthlyBasic          Decimal       @db.Decimal(14, 2)
  totalPayableDays      Decimal       @db.Decimal(4, 2)
  workedDays            Decimal       @db.Decimal(4, 2)

  earnings              Json          @default("[]")
  deductions            Json          @default("[]")

  earnedBasic           Decimal       @db.Decimal(14, 2)
  unearnedBasic         Decimal       @db.Decimal(14, 2)
  additionalEarnings    Decimal       @db.Decimal(14, 2)
  grossPay              Decimal       @db.Decimal(14, 2)
  totalDeductions       Decimal       @db.Decimal(14, 2)
  netPay                Decimal       @db.Decimal(14, 2)

  employeeCodeSnapshot  String        @db.VarChar(30)
  employeeNameSnapshot  String        @db.VarChar(120)

  status                PayrollStatus @default(DRAFT)
  version               Int           @default(1)

  createdByUserId       String        @db.Uuid
  updatedByUserId       String        @db.Uuid

  hrApprovedByUserId    String?       @db.Uuid
  hrApprovedAt          DateTime?     @db.Timestamptz(3)

  adminApprovedByUserId String?       @db.Uuid
  adminApprovedAt       DateTime?     @db.Timestamptz(3)

  paidByUserId          String?       @db.Uuid
  paidAt                DateTime?     @db.Timestamptz(3)

  changeReason          String        @db.VarChar(1000)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salaryVersion   EmployeeSalaryVersion @relation(fields: [salaryVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy       User                  @relation("PayrollCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy       User                  @relation("PayrollUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hrApprovedBy    User?                 @relation("PayrollHrApprover", fields: [hrApprovedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  adminApprovedBy User?                 @relation("PayrollAdminApprover", fields: [adminApprovedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paidBy          User?                 @relation("PayrollPaidActor", fields: [paidByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment         PayrollPayment?

  @@unique([employeeId, payrollMonth], map: "payroll_employee_month_key")
  @@index([payrollMonth, status], map: "payroll_month_status_idx")
  @@index([salaryVersionId], map: "payroll_salary_version_idx")
  @@map("payroll_records")
}

model PayrollPayment {
  id              String               @id @default(uuid()) @db.Uuid
  payrollRecordId String               @unique(map: "payroll_payment_record_key") @db.Uuid
  amount          Decimal              @db.Decimal(14, 2)
  currency        String               @default("PKR") @db.Char(3)
  method          PayrollPaymentMethod
  paidOn          DateTime             @db.Date
  reference       String?              @db.VarChar(120)
  note            String?              @db.VarChar(1000)
  actorUserId     String               @db.Uuid
  recordedAt      DateTime             @default(now()) @db.Timestamptz(3)

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User          @relation("PayrollPaymentActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId, recordedAt], map: "payroll_payment_actor_idx")
  @@map("payroll_payments")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ANNOUNCEMENT
  ATTENDANCE
  PAYROLL
  SYSTEM
  INFO
  WARNING
  SUCCESS
}

model Announcement {
  id           String               @id @default(uuid()) @db.Uuid
  title        String               @db.VarChar(200)
  content      String               @db.Text
  priority     AnnouncementPriority @default(NORMAL)
  status       AnnouncementStatus   @default(PUBLISHED)
  targetRole   Role?
  departmentId String?              @db.Uuid
  pinned       Boolean              @default(false)
  authorUserId String               @db.Uuid
  publishedAt  DateTime?            @db.Timestamptz(3)
  expiresAt    DateTime?            @db.Timestamptz(3)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  author     User              @relation("AnnouncementAuthor", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  department OrganizationUnit? @relation("AnnouncementDepartment", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reads      AnnouncementRead[]

  @@index([status, publishedAt], map: "announcements_status_published_idx")
  @@index([pinned, publishedAt], map: "announcements_pinned_published_idx")
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user         User         @relation("UserAnnouncementReads", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([announcementId, userId], map: "announcement_reads_announcement_user_key")
  @@index([userId, readAt], map: "announcement_reads_user_read_idx")
  @@map("announcement_reads")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  actorUserId String?          @db.Uuid
  title       String           @db.VarChar(200)
  message     String           @db.VarChar(1000)
  type        NotificationType @default(INFO)
  link        String?          @db.VarChar(255)
  isRead      Boolean          @default(false)
  readAt      DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([userId, isRead, createdAt], map: "notifications_user_read_created_idx")
  @@map("notifications")
}