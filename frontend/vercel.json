{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://adrankohrm.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build:vercel"
}
